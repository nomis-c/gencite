# Copy to .env and fill in:  cp .env.example .env
# Any OpenAI-compatible endpoint works (DeepSeek, Groq, Gemini, OpenAI, a local Ollama server, ...).

# Synthesizer (step 6), also used by the judge unless JUDGE_* is set
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Optional: a different model as judge (verifier layer 2, step 8). Empty = same as LLM_*
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# Optional: AMASS GeneCore + BiomedCore evidence. Empty = AMASS source is skipped (error logged per gene)
AMASS_API_KEY=
